---
// Renders a post photo that may be either a local (optimized) image or a remote URL.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	src: ImageMetadata | string;
	alt: string;
	width?: number;
	class?: string;
	loading?: 'lazy' | 'eager';
}

const { src, alt, width = 1000, class: className, loading = 'lazy' } = Astro.props;
---

{
	typeof src === 'string' ? (
		<img src={src} alt={alt} class={className} loading={loading} decoding="async" />
	) : (
		<Image src={src} alt={alt} width={width} class={className} loading={loading} />
	)
}
